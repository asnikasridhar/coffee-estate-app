{
  "expo": {
    "name": "JavaTerrain",
    "slug": "estate-app-asubeige",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
	"newArchEnabled": false,
    "android": {
	 "versionCode": 3,
      "package": "com.estate.manager.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#f5eee3",
      "barStyle": "dark-content"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JavaTerrain to use your location for property-specific local weather."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f7f4ec",
          "dark": {
            "backgroundColor": "#f7f4ec"
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "de27a295-5802-4edd-bfd7-f9378075cfcb"
      }
    }
  }
}
